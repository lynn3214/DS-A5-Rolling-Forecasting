# Original and temporary data: never commit user-provided or downloaded datasets.
data/raw/
data/**/*.csv
data/**/*.xlsx
data/**/*.zip
*.part
*.download

# Large row-level rolling prediction exports are reproducible from saved code,
# protocol, inputs, metrics, and manifests; preserve compact evidence instead.
results/rolling/*_predictions.csv
results/rolling/attempt_*/*_predictions.csv

# Python and test artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# Environments and local configuration
.venv/
venv/
env/
conda-env/
.env
.env.*
!.env.example

# Local OS/editor files
.DS_Store
.vscode/
.idea/

# Temporary files
*.tmp
*.swp
*~
